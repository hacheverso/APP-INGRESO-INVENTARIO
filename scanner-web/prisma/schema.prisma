generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  sheetsUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]
  sessions HistorySession[]
}

model Product {
  id        String   @id @default(cuid())
  upc       String
  sku       String
  name      String
  image     String?
  category  String   @default("")
  holdedId  String?
  lastCost  Float    @default(0)
  lastCostAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String   @default("")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([upc, userId])
}

model HistorySession {
  id         String   @id @default(uuid())
  date       String
  batchName  String?
  provider   String?
  totalItems Int
  totalCop   Float
  records    HistoryRecord[]
  createdAt  DateTime @default(now())

  holdedInvoiceId  String?
  holdedInvoiceNum String?

  userId String   @default("")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HistoryRecord {
  id        String   @id @default(uuid())
  sessionId String
  session   HistorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  fecha     String
  cantidad  Int
  seriales  String
  tipo      String   @default("MASIVO")
  upc       String
  sku       String
  nombre    String
  imagen    String   @default("")
  costoUsd  Float
  costoCop  Float
  trm       Float
  
  createdAt DateTime @default(now())
}

// Ventas de Holded guardadas por documento (factura / ticket). Permite detectar
// facturas borradas o editadas: cada sincronización reemplaza el documento completo y la
// reconciliación diaria elimina los que ya no existen en Holded dentro de la ventana revisada.
model HoldedSaleDoc {
  id        String   @id @default(cuid())
  userId    String
  docId     String   // id del documento en Holded
  tipo      String   // invoice | salesreceipt
  date      DateTime
  keys      String[] // "pid:<holdedId>" | "sku:<SKU>" | "name:<NOMBRE>" de cada línea
  lines     Json?    // [{ pid?, sku?, name?, units }] por línea, para contar unidades vendidas
  updatedAt DateTime @updatedAt

  @@unique([userId, docId])
  @@index([userId, date])
}

model HoldedSyncState {
  userId            String    @id
  salesSyncedAt     DateTime?  // última sincronización incremental
  salesReconciledAt DateTime?  // última reconciliación de la ventana reciente (detecta borrados/ediciones)
  indexVersion      Int       @default(0) // versión del formato del índice; si cambia, se reconstruye una vez
  updatedAt         DateTime  @updatedAt
}

// (legado, ya no se usa; se conserva para no forzar un borrado de tabla en el despliegue)
model HoldedSalesIndex {
  id         String   @id @default(cuid())
  userId     String
  key        String
  lastSaleAt DateTime
  updatedAt  DateTime @updatedAt

  @@unique([userId, key])
}
